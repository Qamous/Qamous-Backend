        }
      ],
      "source": "firewall_custom",
      "version": "1"
    },
    "rate": {
      "description": "Free-plan protections; preserve verified search crawlers",
      "id": "40fb61e71a1c4e0b99fd8ea5998e8755",
      "kind": "zone",
      "last_updated": "2026-10-16T21:00:42.349635Z",
      "name": "Qamous free security controls",
      "phase": "http_ratelimit",
      "rules": [
        {
          "action": "block",
          "description": "60 data/page requests per 10 seconds per IP; verified search bots exempt",
          "enabled": true,
          "expression": "(starts_with(http.request.uri.path, \"/api/\") or starts_with(http.request.uri.path, \"/word\") or starts_with(http.request.uri.path, \"/definitions\") or starts_with(http.request.uri.path, \"/users\") or starts_with(http.request.uri.path, \"/reactions\") or starts_with(http.request.uri.path, \"/posts\") or starts_with(http.request.uri.path, \"/auth/\") or starts_with(http.request.uri.path, \"/rag\")) and not cf.client.bot",
          "id": "34270bbd08d84fde89e4fb1795459bc1",
          "last_updated": "2026-10-16T21:00:42.349635Z",
          "ratelimit": {
            "characteristics": [
              "cf.colo.id",
              "ip.src"
            ],
            "mitigation_timeout": 10,
            "period": 10,
            "requests_per_period": 60
          },
          "ref": "qamous_public_data_burst_limit",
          "version": "1"
        }
      ],
      "source": "rate_limit",
      "version": "1"
