      "name": "Qamous free security controls",
      "phase": "http_request_firewall_custom",
      "rules": [
        {
          "action": "block",
          "description": "Block secret-file and unused legacy admin probes",
          "enabled": true,
          "expression": "starts_with(lower(http.request.uri.path), \"/.git\") or starts_with(lower(http.request.uri.path), \"/.env\") or starts_with(lower(http.request.uri.path), \"/wp-admin\") or lower(http.request.uri.path) eq \"/wp-login.php\" or starts_with(lower(http.request.uri.path), \"/phpmyadmin\")",
          "id": "601f4e8fa2fb4bdfa3368569b9f7d49c",
          "last_updated": "2026-10-16T21:00:41.426853Z",
